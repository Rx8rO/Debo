{
  "id": "ADGo9KrlgAmEqm3aTHZIpA",
  "version": "1.4.1",
  "package": {
    "server": {
      "launch": "dist/main.js",
      "deploy": ["dist"],
      "nodeModules": ["node_modules"]
    }
  },
  "settings": {
    "groups": [
      {
        "key": "moderation",
        "title": "Moderation",
        "items": [
          {
            "key": "adminRole",
            "title": "Admin Role",
            "description": "Only members with this selected role can use Debo's moderation commands; this setting does not grant additional Root permissions.",
            "required": true,
            "confirmation": "Save",
            "roleOrMember": {
              "selectBehavior": "role",
              "userIds": [],
              "communityRoleIds": []
            }
          }
        ]
      }
    ]
  },
  "permissions": {
    "community": {
      "kick": true,
      "createBan": true,
      "manageBans": true,
      "manageRoles": true
    },
    "channel": {
      "createMessage": true,
      "deleteMessageOther": true,
      "viewMessageHistory": true
    }
  }
}
